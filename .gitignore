# Secretos — nunca versionar
.env
backend/.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Obsidian: la config del vault sí se versiona, el estado local no
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Sistema
.DS_Store
Thumbs.db

# Logs de depuración locales
backend/groq_error*.txt

# Cloudflare Pages: caché/estado local de `wrangler`, no es código fuente
web/.wrangler/
.wrangler/

# Copias minificadas/ofuscadas generadas por web/build.js — no son fuente de
# verdad, no se versionan. dist_pi: scp a ~/hslv-web en la Raspberry Pi.
# dist_cf: deploy a Cloudflare Pages (wrangler pages deploy dist_cf).
web/dist_pi/
web/dist_cf/

# Dependencias de build.js (terser/clean-css/html-minifier-terser)
web/node_modules/
