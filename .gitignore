# Secretos — nunca versionar
.env
backend/.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Obsidian: la config del vault sí se versiona, el estado local no
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Sistema
.DS_Store
Thumbs.db

# Logs de depuración locales
backend/groq_error*.txt

# Cloudflare Pages: caché/estado local de `wrangler`, no es código fuente
web/.wrangler/
.wrangler/

# Copia minificada/ofuscada solo para la Raspberry Pi (ver scp a ~/hslv-web)
# — generada a partir de web/, no es fuente de verdad, no se versiona.
web/dist_pi/

# Dependencias de build.js (terser/clean-css/html-minifier-terser)
web/node_modules/
