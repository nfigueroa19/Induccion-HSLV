# Copiar a backend/.env para desarrollo local. NUNCA versionar el .env real.
# En Render estas mismas variables se cargan desde el panel de Environment.

# --- Base de datos (Supabase, plan gratuito) -------------------------------
# Usar el "Connection Pooler" en modo transacción (puerto 6543), no el directo.
DATABASE_URL=postgresql://postgres.xxxxxxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Cifrado de identidades ------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# CLAVE_DATOS descifra nombre y cédula. Si se pierde, los datos son irrecuperables.
# PEPPER_CEDULA no puede cambiar nunca: cambia los hashes y rompe la deduplicación.
CLAVE_DATOS=
PEPPER_CEDULA=

CAMPANA=2026

# --- CORS ------------------------------------------------------------------
# Dominio exacto del sitio en Netlify, separados por coma si hay más de uno.
# En desarrollo local: http://localhost:8899
ORIGENES=https://induccion-hslv.netlify.app,https://induccion-hslv.onrender.com

# --- Monitoreo -------------------------------------------------------------
# Protege GET /v1/estado (conteos de la cola, sin datos personales).
# Si queda vacío, el endpoint responde 404. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Panel de administración (jefes de servicio) ----------------------------
# Firma los tokens de sesión de /v1/admin/login. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si queda vacío, los endpoints /v1/admin/* responden 404.
JWT_SECRET=
ADMIN_SESION_MIN=15

# --- Correo (Resend) ---------------------------------------------------------
# Vacío = envío deshabilitado, no rompe nada. Sin dominio verificado en
# Resend, RESEND_FROM debe quedar en "onboarding@resend.dev" y solo llega al
# correo con el que se creó la cuenta de Resend (modo sandbox).
RESEND_API_KEY=
RESEND_FROM=Unidad de Inteligencia Artificial HSLV <onboarding@resend.dev>

# --- Worker ----------------------------------------------------------------
# En el plan gratuito de Render no hay Background Worker: el loop corre dentro
# de la misma API. Ver backend/README.md.
WORKER_EMBEBIDO=true
WORKER_LOTE=8
WORKER_CONCURRENCIA=4
WORKER_PAUSA_SEG=2

# --- Proveedores de LLM -----------------------------------------------------
# OpenAI (de pago, modelo principal) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# El resto son de nivel gratuito y quedan de respaldo automático (ver
# proveedores.py: solo entran en juego si OpenAI falla o se queda sin cupo).
# NVIDIA NIM — https://build.nvidia.com  (registro gratis, sin tarjeta)
NVIDIA_API_KEY=

# Otras llaves gratuitas del combo. Dejar vacías las que no se usen:
# el catálogo de proveedores ignora las que no estén configuradas.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# OmniRoute: solo si se corre el gateway. En desarrollo local apunta a
# http://localhost:20128/v1 ; vacío en Render (ver README).
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
